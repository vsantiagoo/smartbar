# ── Supabase ────────────────────────────────────────────────
# Sem estas variáveis o app roda em MODO DEMO (dados em memória, sem banco).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Pix (Asaas / Mercado Pago) ──────────────────────────────
PIX_PROVIDER=mock            # mock | asaas | mercadopago
PIX_WEBHOOK_TOKEN=troque-este-token
ASAAS_API_KEY=

# ── Hardware IoT (ESP32) ────────────────────────────────────
# Chave enviada pelo ESP32 no header x-device-key ao chamar /api/iot/rfid
IOT_DEVICE_KEY=troque-esta-chave
MQTT_URL=

# ── Ferramentas de demonstração ─────────────────────────────
# "true" mostra botões de simulação (pagar Pix, aproximar cartão). Desligue em produção.
NEXT_PUBLIC_DEMO_TOOLS=true
