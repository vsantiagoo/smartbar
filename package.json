{
  "name": "smartbar",
  "version": "0.1.0",
  "private": true,
  "description": "SmartBar — gestão inteligente de minibares para hotéis (SaaS B2B2C)",
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true,maxRetries:5,retryDelay:200});if(fs.existsSync('.next')){console.error('Nao consegui apagar .next (OneDrive?). Rode: Remove-Item .next -Recurse -Force');process.exit(1)}\"",
    "predev": "npm run clean",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "next": "^15.5.25",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0"
  }
}
